{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/panduan", "destination": "/panduan-pemesanan.html" },
    { "source": "/panduan-pemesanan.html", "destination": "/panduan-pemesanan.html" },
    { "source": "/qr", "destination": "/qr-generator-gan-en.html" },
    { "source": "/qr-generator-gan-en.html", "destination": "/qr-generator-gan-en.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
